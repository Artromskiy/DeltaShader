<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Shader.ComputeTextureFixture</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DeltaShaderEnabled>true</DeltaShaderEnabled>
  </PropertyGroup>

  <ItemGroup>
    <DeltaShaderSource Include="Shaders/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DeltaShader/DeltaShader.csproj" />
    <ProjectReference Include="../../../DeltaRender/src/DeltaRender.Graphics.Semantics/DeltaRender.Graphics.Semantics.csproj" />
    <PackageReference Include="DeltaMaths" />
    <PackageReference Include="DeltaShader.Compiler" PrivateAssets="all" />
    <PackageReference Include="DeltaShader.Analyzers" PrivateAssets="all" OutputItemType="Analyzer" />
    <PackageReference Include="DeltaShader.Contract" PrivateAssets="all" />
    <PackageReference Include="DeltaShader.Tool" PrivateAssets="all" />
  </ItemGroup>
</Project>
