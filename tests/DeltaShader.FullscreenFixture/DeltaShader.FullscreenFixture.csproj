<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Shader.FullscreenFixture</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DeltaShaderEnabled>true</DeltaShaderEnabled>
  </PropertyGroup>

  <ItemGroup>
    <DeltaShaderSource Include="..\DeltaShader.TestShaders\Shaders\FullscreenUi.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\DeltaShader.TestShaders\Shaders\FullscreenUi.cs" Link="FullscreenUi.cs" />
    <PackageReference Include="DeltaMaths" />
    <PackageReference Include="DeltaShader.Compiler" PrivateAssets="all" />
    <PackageReference Include="DeltaShader.Analyzers" PrivateAssets="all" OutputItemType="Analyzer" />
    <PackageReference Include="DeltaShader.Contract" PrivateAssets="all" />
    <PackageReference Include="DeltaShader.Tool" PrivateAssets="all" />
  </ItemGroup>
</Project>
