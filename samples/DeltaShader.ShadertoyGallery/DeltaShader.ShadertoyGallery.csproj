<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Shader.ShadertoyGallery</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DeltaShaderEnabled>true</DeltaShaderEnabled>
    <DeltaShaderToolPath>$(MSBuildProjectDirectory)\..\..\src\DeltaShader.Tool\bin\$(Configuration)\net10.0\DeltaShader.Tool.dll</DeltaShaderToolPath>
  </PropertyGroup>

  <ItemGroup>
    <DeltaShaderSource Include="Shaders/**/*.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildProjectDirectory)\..\..\src\DeltaShader.Tool\build\DeltaShader.props" />

  <ItemGroup>
    <ProjectReference Include="..\DeltaShader\DeltaShader.csproj" />
    <ProjectReference Include="..\..\..\DeltaMaths\src\DeltaMaths\DeltaMaths.csproj">
      <SetTargetFramework>TargetFramework=netstandard2.1</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="gallery\catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="$(MSBuildProjectDirectory)\..\..\src\DeltaShader.Tool\build\DeltaShader.targets" />
</Project>
