<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <DeltaShaderEnabled>true</DeltaShaderEnabled>
  </PropertyGroup>

  <ItemGroup>
    <DeltaShaderSource Include="Shaders/**/*.cs" Exclude="Shaders/AddBias.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="Shaders/AddBias.cs" />
    <Compile Remove="tools/**/*.cs" />
    <PackageReference Include="DeltaMaths" />
    <PackageReference Include="DeltaShader.Compiler" PrivateAssets="all" />
    <PackageReference Include="DeltaShader.Analyzers" PrivateAssets="all" OutputItemType="Analyzer" />
    <PackageReference Include="DeltaShader.Contract" PrivateAssets="all" />
    <PackageReference Include="DeltaShader.Tool" PrivateAssets="all" />
  </ItemGroup>
</Project>
