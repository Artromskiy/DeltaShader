<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.Shader.Tool</RootNamespace>
    <AssemblyName>DeltaShader.Tool</AssemblyName>
    <PackageId>DeltaShader.Tool</PackageId>
    <!-- Synchronized with the latest DeltaShader repository tag: v0.0.20. -->
    <Version>0.0.20</Version>
    <Description>Roslyn-based C# shader compiler and MSBuild integration for GLSL/SPIR-V artifact generation.</Description>
    <PackageTags>shader;glsl;spirv;vulkan;roslyn;msbuild</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU1301</NoWarn>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="build/DeltaShader.Tool.props" Pack="true" PackagePath="buildTransitive/DeltaShader.Tool.props" />
    <None Include="build/DeltaShader.Tool.targets" Pack="true" PackagePath="buildTransitive/DeltaShader.Tool.targets" />
    <ProjectReference Include="..\DeltaShader.Contract\DeltaShader.Contract.csproj" />
    <ProjectReference Include="..\DeltaShader.Analyzers\DeltaShader.Analyzers.csproj" />
    <ProjectReference Include="..\\DeltaShader.Compiler\\DeltaShader.Compiler.csproj" />
    <ProjectReference Include="..\\DeltaShader.Backend.Glsl\\DeltaShader.Backend.Glsl.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Build.Locator" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectDeltaShaderToolPackageFiles</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="CollectDeltaShaderToolPackageFiles" Returns="@(TfmSpecificPackageFile)">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetDir)**"
                              Exclude="$(TargetDir)**\*.pdb;$(TargetDir)**\*.xml;$(TargetDir)**\*.pri">
        <PackagePath>tools/net10.0/any/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
