<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Delta.Shader.Analyzers</RootNamespace>
    <AssemblyName>DeltaShader.Analyzers</AssemblyName>
    <PackageId>DeltaShader.Analyzers</PackageId>
    <Version>0.0.19</Version>
    <Description>Roslyn analyzers and source generators for DeltaShader.</Description>
    <PackageTags>shader;roslyn;analyzer;source-generator</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\DeltaShader.Backend.Glsl\\DeltaShader.Backend.Glsl.csproj" />
    <ProjectReference Include="..\\DeltaShader.Compiler\\DeltaShader.Compiler.csproj" />
    <ProjectReference Include="..\\DeltaShader\\DeltaShader.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <Target Name="CopyDeltaShaderAnalyzerDependencies" AfterTargets="Build">
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CollectDeltaShaderAnalyzerPackageFiles" Returns="@(TfmSpecificPackageFile)">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)">
        <PackagePath>analyzers/dotnet/cs/$(TargetFileName)</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(TargetDir)DeltaShader.Analyzers.dll;$(TargetDir)DeltaShader.Backend.Glsl.dll;$(TargetDir)DeltaShader.Compiler.dll;$(TargetDir)DeltaShader.dll">
        <PackagePath>analyzers/dotnet/cs/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectDeltaShaderAnalyzerPackageFiles</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
</Project>
