<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Delta.Shader.Compiler</RootNamespace>
    <AssemblyName>DeltaShader.Compiler</AssemblyName>
    <PackageId>DeltaShader.Compiler</PackageId>
    <Description>Build-time DeltaShader compiler frontend and typed shader IR.</Description>
    <PackageTags>shader;compiler;roslyn;glsl;spirv</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\DeltaShader\\DeltaShader.csproj" />
    <EmbeddedResource Include="../../../DeltaMaths/src/DeltaMaths/Vectors/shader-contract.json" Link="Contracts/shader-contract.json" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
</Project>
