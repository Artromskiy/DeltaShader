<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Delta.Shader.Compiler</RootNamespace>
    <AssemblyName>DeltaShader.Compiler</AssemblyName>
    <PackageId>DeltaShader.Compiler</PackageId>
    <Version>0.0.15</Version>
    <RepositoryUrl>https://github.com/Artromskiy/DeltaShader</RepositoryUrl>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Description>Build-time DeltaShader compiler frontend and typed shader IR.</Description>
    <PackageTags>shader;compiler;roslyn;glsl;spirv</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\DeltaShader\\DeltaShader.csproj" PrivateAssets="all" />
    <EmbeddedResource Include="../../../DeltaMaths/src/DeltaMaths/Vectors/shader-contract.json" Link="Contracts/shader-contract.json" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectDeltaShaderCompilerPackageFiles</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="CollectDeltaShaderCompilerPackageFiles" Returns="@(TfmSpecificPackageFile)">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetDir)**\\*.dll"
                              Exclude="$(TargetDir)$(TargetFileName)">
        <PackagePath>lib/netstandard2.0/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
